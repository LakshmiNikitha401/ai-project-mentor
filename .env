# Flask Application Secret
FLASK_SECRET_KEY=your_flask_secret_key_here

# PostgreSQL Database (Supabase)
DATABASE_URL=postgresql://postgres.your_id:your_password@aws-0-region.pooler.supabase.com:5432/postgres

# AI Generation Keys
GROQ_API_KEY_1=gsk_your_primary_groq_key_here
GROQ_API_KEY_2=gsk_your_fallback_groq_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Email Configuration (Gmail API)
MAIL_EMAIL=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password_here
